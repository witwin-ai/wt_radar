{
  "id": "witwin.radar",
  "name": "Radar (FMCW)",
  "version": "0.1.0",
  "author": "",
  "description": "Runs witwin.radar FMCW simulations from ordinary Studio meshes, while preserving the full Radar config, optional motion round-trip, timeline, and in-component range-doppler / point-cloud / MUSIC / CFAR signal visualization.",
  "license": "GPL-3.0-or-later",
  "engines": { "witwin": "^1.0.0" },
  "dependencies": ["scipy", "numpy"],
  "contributes": {
    "solvers": [
      {
        "id": "witwin.radar.simulate",
        "title": "Radar FMCW",
        "entry": "solver_host.py",
        "runtime": { "python": "${backend:python}" },
        "lifecycle": "warm",
        "idleTimeoutSec": 300,
        "cancelGraceSec": 5,
        "maxParallel": 1,
        "capabilities": {
          "cancel": true,
          "partials": true,
          "query": ["raw_signal", "range_doppler", "point_cloud", "music"]
        }
      }
    ]
  },
  "icon": "radar",
  "enabled": true
}
