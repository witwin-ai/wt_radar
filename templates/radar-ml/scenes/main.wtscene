format = 3
id = "main"
role = "main"

[[parameter]]
id = "prm_1qkzzf"
name = "target_range"
expr = "6.0"
description = "Distance of the car ahead of the radar, in metres (along -z)"

[[parameter]]
id = "prm_7bax4t"
name = "target_offset"
expr = "0.9"
description = "Sideways offset of the car from the radar axis, in metres (+x)"

[[entity]]
id = "radar_target"
name = "Radar Target"
type = "builtin.mesh"
transform = {pos = [0.9, 0.65, -6.0], rot = [0.0, 0.0, 0.0, 1.0], eul = [0.0, 0.0, 0.0], scl = [1.8, 1.3, 4.3]}
components = [
    {type = "Material", color = "#a3242cff", metalness = 0.6, roughness = 0.35, normal_strength = 1.0, occlusion_strength = 1.0, emissive_color = "#000000ff", emissive_intensity = 0.0, alpha = 1.0, alpha_mode = "opaque", alpha_cutoff = 0.5, double_sided = false, material_name = "metal", model = "scalar", eps_r = [8.0, 0.0], mu_r = 1.0, sigma_e = 0.0, debye_poles = [], drude_poles = [], lorentz_poles = [], mu_debye_poles = [], mu_drude_poles = [], mu_lorentz_poles = [], epsilon_tensor = [1.0, 1.0, 1.0], mu_tensor = [1.0, 1.0, 1.0], sigma_e_tensor = [0.0, 0.0, 0.0], kerr_chi3 = 0.0},
    {type = "Mesh", vertices = {is_array = true,shape = [8, 3],base_type = "vector3"}, mesh_type = "Cube"},
]
fields = [{target = "Transform.position", unit = "m", expr = ["target_offset", "", "-target_range"]}]

